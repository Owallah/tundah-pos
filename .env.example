# ============================================================================
# Nyota POS — environment
# Copy to .env.local. NEVER commit the filled version.
#
# RULE: anything WITHOUT the NEXT_PUBLIC_ prefix must never reach the browser.
# A CI check greps the client bundle for these values and fails the build.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ⚠️ SERVER ONLY. Bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

BUSINESS_ID=00000000-0000-0000-0000-000000000000

# ── KRA eTIMS OSCU ──────────────────────────────────────────────────────────
# Start with 'null'. The POS runs, takes money, and prints PROVISIONAL
# receipts. Move to 'mock' for CI, then 'oscu' after KRA certification.
ETIMS_PROVIDER=null                  # null | mock | oscu
ETIMS_ENVIRONMENT=SANDBOX            # SANDBOX | PRODUCTION

ETIMS_TIN=P000000000X                # your KRA PIN
ETIMS_BHF_ID=00                      # branch id
ETIMS_DVC_SRL_NO=                    # KRA-APPROVED serial. Do not invent one.
ETIMS_CMC_KEY=                       # returned by initialiseDevice(). Secret.

ETIMS_OPERATOR_ID=POS
ETIMS_OPERATOR_NAME=Nyota POS

# ── Open questions, made configurable rather than guessed ───────────────────
# K5: v2.0 documents these in the BODY; current SDKs use HEADERS.
ETIMS_AUTH_TRANSPORT=both            # body | header | both
# K3: KRA's own sales and purchase samples disagree. Default follows SALES.
ETIMS_TAXABLE_CONVENTION=gross       # gross | net

# ── Safaricom Daraja ────────────────────────────────────────────────────────
MPESA_ENVIRONMENT=SANDBOX            # SANDBOX | PRODUCTION
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=                     # Buy Goods Till or Paybill
MPESA_STORE_NUMBER=                  # Buy Goods only; often differs from Till
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# Must be STABLE Edge Function URLs, not Vercel deployment URLs (which change
# every deploy). Safaricom whitelisting is slow to update.
MPESA_CALLBACK_URL=https://xxxx.supabase.co/functions/v1/mpesa-stk-callback
MPESA_CONFIRMATION_URL=https://xxxx.supabase.co/functions/v1/mpesa-c2b-confirm
MPESA_VALIDATION_URL=https://xxxx.supabase.co/functions/v1/mpesa-c2b-validate

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://pos.example.co.ke
NEXT_PUBLIC_RECEIPT_BASE_URL=https://pos.example.co.ke/r
